{
  "name": "chess-online",
  "version": "1.0.0",
  "description": "Professional online chess application with TDD and best practices",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:4000": "set PORT=4000 && node server.js",
    "dev": "node --watch server.js",
    "test": "jest tests/chess-engine.test.js",
    "test:watch": "jest tests/chess-engine.test.js --watch",
    "test:coverage": "jest tests/chess-engine.test.js --coverage",
    "test:e2e": "playwright test",
    "test:ui": "node tests/ui-tests.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "type-check": "jsdoc --tsc",
    "security-check": "npm audit",
    "performance-test": "node tests/performance/benchmark.js"
  },
  "dependencies": {
    "chess.js": "^1.0.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "rate-limiter-flexible": "^2.4.2",
    "uuid": "^9.0.1",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "supertest": "^6.3.3",
    "socket.io-client": "^4.7.5",
    "@playwright/test": "^1.40.1",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.1.1",
    "jsdoc": "^4.0.2",
    "nodemon": "^3.0.2",
    "benchmark": "^2.1.4",
    "@types/jest": "^29.5.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!tests/**",
      "!coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "eslintConfig": {
    "extends": "airbnb-base",
    "rules": {
      "no-console": "warn",
      "max-len": ["error", { "code": 120 }],
      "indent": ["error", 2],
      "quotes": ["error", "single"],
      "semi": ["error", "always"]
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true
  }
}
